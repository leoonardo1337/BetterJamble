{
  "manifest_version": 3,
  "name": "WiseLive",
  "version": "3.27.0",
  "description": "Exporta pedidos da Jamble, mostra o total vendido nas lives e abre um painel com ranking de gemas, compradores e sorteio.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WiseLive",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "https://www.jamble.com/*"
  ]
}
